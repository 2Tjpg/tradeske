# Required: Deriv application registered at https://developers.deriv.com/dashboard/
NEXT_PUBLIC_DERIV_APP_ID=your_deriv_app_id

# Required: must exactly match the redirect URI registered for the Deriv app.
# Local example: http://localhost:3000
# Vercel example: https://your-production-domain.vercel.app
NEXT_PUBLIC_DERIV_REDIRECT_URI=http://localhost:3000

# Public application branding
NEXT_PUBLIC_DERIV_APP_NAME=Tradeske
NEXT_PUBLIC_DERIV_SHOW_APP_NAME=true
NEXT_PUBLIC_FONT_FAMILY=Inter

# Optional: Deriv affiliate/referral URL used by Sign Up and Get Started CTAs
NEXT_PUBLIC_DERIV_REFERRAL_LINK=https://deriv.com/signup/

# OAuth scopes required by the trading application
NEXT_PUBLIC_DERIV_OAUTH_SCOPES=trade

# Use production for live Deriv endpoints; use preview only for staging
NEXT_PUBLIC_DERIV_ENV=production

# Optional when hosting under a URL sub-path; normally blank on Vercel
NEXT_PUBLIC_BASE_PATH=
